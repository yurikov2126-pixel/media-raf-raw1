{
  "name": "media-raf-raw-server",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env.local src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src tests --ext .js",
    "lint:fix": "eslint src tests --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed/seed.js",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.0",
    "swagger-jsdoc": "^7.0.0-rc.6",
    "swagger-ui-express": "^5.0.1",
    "vite": "^8.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
