generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  email        String?   @unique
  username     String    @unique
  passwordHash String
  firstName    String
  lastName     String
  fullName     String
  avatar       String?
  cover        String?
  bio          String?
  birthDate    DateTime?
  group        String?
  city         String?
  role         String    @default("STUDENT")
  direction    String?
  skills       String    @default("[]")
  socials      String    @default("{}")
  isBanned     Boolean   @default(false)
  lastSeen     DateTime?
  createdAt    DateTime  @default(now())

  // Онбординг и инвалидация токенов
  onboardingVersion Int       @default(0)
  passwordChangedAt DateTime?

  // Базовые связи
  posts         Post[]
  comments      Comment[]
  postReactions PostReaction[]
  chatMembers   ChatMember[]
  messages      Message[]
  reactions     Reaction[]
  enrollments   Enrollment[]
  progress      LessonProgress[]
  attempts      TestAttempt[]
  certificates  Certificate[]
  notifications Notification[]
  wikiArticles  WikiArticle[]
  pushSubs      PushSubscription[]

  // Модерация
  reportsMade     Report[] @relation("ReporterReports")
  reportsResolved Report[] @relation("ResolverReports")

  // Восстановление пароля
  passwordResetRequests PasswordResetRequest[]

  // Геймификация
  stats        UserStats?
  achievements UserAchievement[]
  xpLog        XpLog[]
  dailyQuests  DailyQuest[]

  // Курсы: практики и ДЗ
  supervisedPracticals PracticalWork[]       @relation("PracticalSupervisor")
  practicalSubmissions PracticalSubmission[] @relation("PracticalSubmitter")
  practicalReviews     PracticalSubmission[] @relation("PracticalReviewer")
  homeworkSubmissions  HomeworkSubmission[]  @relation("HomeworkSubmitter")
  homeworkReviews      HomeworkSubmission[]  @relation("HomeworkReviewer")
}

model Post {
  id        String    @id @default(cuid())
  authorId  String
  content   String
  mediaUrl  String?
  mediaType String?
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions PostReaction[]

  @@index([createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
}

model Chat {
  id              String       @id @default(cuid())
  type            String       @default("DIRECT")
  title           String?
  avatar          String?
  createdBy       String?
  pinnedMessageId String?
  createdAt       DateTime     @default(now())
  members         ChatMember[]
  messages        Message[]
}

model ChatMember {
  id       String   @id @default(cuid())
  chatId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  lastRead DateTime @default(now())
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

model Message {
  id            String    @id @default(cuid())
  chatId        String
  senderId      String
  type          String    @default("text")
  content       String
  replyToId     String?
  forwardedFrom String?
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo   Message?   @relation("Reply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]  @relation("Reply")
  reactions Reaction[]
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Course {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  title                  String
  description            String
  cover                  String?
  category               String
  level                  String   @default("beginner")
  published              Boolean  @default(false)
  certificateTitle       String?  @default("Сертификат о прохождении курса")
  certificateDescription String?
  dripMode               String?
  dripInterval           Int?
  weeklyLessonLimit      Int?     @default(3)
  createdAt              DateTime @default(now())

  lessons      Lesson[]
  enrollments  Enrollment[]
  certificates Certificate[]
  practicals   PracticalWork[]
}

model Lesson {
  id       String  @id @default(cuid())
  courseId String
  title    String
  content  String
  videoUrl String?
  order    Int     @default(0)
  duration Int     @default(0)

  // Если у урока есть практика — следующий урок не откроется,
  // пока практика не будет одобрена руководителем.
  requiresPractical Boolean @default(false)

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  test     Test?
  progress LessonProgress[]

  // Практическое занятие с руководителем (1:1)
  practical PracticalWork?

  // Домашнее задание (1:1) — не блокирует прогресс, висит плашкой
  homework Homework?
}

model Test {
  id        String        @id @default(cuid())
  lessonId  String        @unique
  title     String
  passScore Int           @default(70)
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  TestAttempt[]
}

model Question {
  id      String @id @default(cuid())
  testId  String
  type    String @default("single")
  text    String
  payload String @default("{}")
  points  Int    @default(1)
  test    Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestAttempt {
  id        String   @id @default(cuid())
  testId    String
  userId    String
  score     Int
  passed    Boolean
  answers   String
  createdAt DateTime @default(now())
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  progress  Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Certificate {
  id          String   @id @default(cuid())
  serial      String   @unique
  userId      String
  courseId    String
  title       String
  description String?
  template    String   @default("gradient")
  issuedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   String    @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Setting {
  key   String @id
  value String
}

model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  payload   String   @default("{}")
  affected  Int      @default(0)
  duration  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

model WikiCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  icon        String?       @default("📄")
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  articles    WikiArticle[]
}

model WikiArticle {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String?
  content    String
  cover      String?
  tags       String   @default("[]")
  published  Boolean  @default(true)
  views      Int      @default(0)
  categoryId String?
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category WikiCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([published])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * ─────────── Модерация жалоб ───────────
 */

model Report {
  id         String    @id @default(cuid())
  reporterId String
  targetType String // post | comment | message | user
  targetId   String
  reason     String // spam | abuse | illegal | other
  comment    String?
  status     String    @default("NEW") // NEW | IN_REVIEW | RESOLVED | REJECTED
  resolvedBy String?
  resolvedAt DateTime?
  resolution String?
  createdAt  DateTime  @default(now())

  reporter User  @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User? @relation("ResolverReports", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

/**
 * ─────────── Восстановление пароля ───────────
 */

model PasswordResetRequest {
  id     String @id @default(cuid())
  userId String
  status String @default("PENDING") // PENDING | CODE_ISSUED | COMPLETED | REJECTED | EXPIRED

  codeHash    String?
  codeExpires DateTime?
  attempts    Int       @default(0)

  issuedBy String?
  issuedAt DateTime?
  usedAt   DateTime?

  rejectedBy String?
  rejectedAt DateTime?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

/**
 * ─────────── Геймификация ───────────
 */

model UserStats {
  userId               String   @id
  xp                   Int      @default(0)
  level                Int      @default(1)
  streakCurrent        Int      @default(0)
  streakBest           Int      @default(0)
  lastActiveDate       String?
  lastInactivityCharge String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xp])
  @@index([level])
  @@index([streakCurrent])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model XpLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model DailyQuest {
  id          String    @id @default(cuid())
  userId      String
  date        String // YYYY-MM-DD (UTC)
  type        String // post_count | comment_count | lesson_count | test_pass | reaction_given | certificate_earned
  target      Int
  current     Int       @default(0)
  xpReward    Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
  @@index([userId, date])
  @@index([completed, date])
}

model QuestTemplate {
  id        String   @id @default(cuid())
  type      String
  target    Int
  xpReward  Int
  label     String?
  icon      String?
  weight    Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Achievement {
  id          String   @id // стабильный ключ, например "first_post"
  title       String
  description String
  icon        String   @default("🏆")
  rarity      String   @default("common")
  counter     String? // postsCount | commentsCount | ...
  threshold   Int?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

/**
 * ─────────── Практические занятия ───────────
 */

model PracticalWork {
  id           String    @id @default(cuid())
  lessonId     String    @unique
  courseId     String
  topic        String // Тема занятия
  description  String // Что делать на занятии
  location     String? // Аудитория / онлайн
  scheduledAt  DateTime? // Дата и время занятия
  durationMin  Int       @default(90)
  supervisorId String? // Руководитель (MENTOR/ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lesson      Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course      Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  supervisor  User?                 @relation("PracticalSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  submissions PracticalSubmission[]

  @@index([courseId])
  @@index([scheduledAt])
  @@index([supervisorId])
}

model PracticalSubmission {
  id          String    @id @default(cuid())
  practicalId String
  userId      String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note        String? // Комментарий студента
  reviewedBy  String?
  reviewedAt  DateTime?
  feedback    String? // Комментарий руководителя
  grade       Int? // 1..5
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  practical PracticalWork @relation(fields: [practicalId], references: [id], onDelete: Cascade)
  user      User          @relation("PracticalSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User?         @relation("PracticalReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([practicalId, userId])
  @@index([status])
  @@index([userId])
  @@index([reviewedBy])
}

/**
 * ─────────── Домашние задания ───────────
 */

model Homework {
  id            String   @id @default(cuid())
  lessonId      String   @unique
  title         String
  description   String
  maxFiles      Int      @default(3)
  maxFileSizeMb Int      @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson      Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id         String    @id @default(cuid())
  homeworkId String
  userId     String
  text       String? // Текстовый ответ
  link       String? // Ссылка (например, на облако)
  files      String    @default("[]") // JSON: [{url, name, type, size}]
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy String?
  reviewedAt DateTime?
  feedback   String?
  grade      Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user     User     @relation("HomeworkSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?    @relation("HomeworkReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([homeworkId, userId])
  @@index([status])
  @@index([userId])
  @@index([reviewedBy])
}
